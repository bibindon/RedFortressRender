#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_JPN)
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 300, 664
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "MS UI Gothic", 400, 0, 0x80
BEGIN
    LTEXT           "Saturation",IDC_STATIC_SATURATE_LABEL,6,6,30,8
    EDITTEXT        IDC_EDIT_SATURATE_LEVEL,42,0,48,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "-",IDC_BUTTON_SATURATE_DOWN,162,0,12,14
    PUSHBUTTON      "+",IDC_BUTTON_SATURATE_UP,174,0,12,14
    PUSHBUTTON      "Reset",IDC_BUTTON_SATURATE_RESET,186,0,24,14
    CONTROL         "",IDC_SLIDER_SATURATE_LEVEL,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,96,0,60,12
    CONTROL         "Animate Light",IDC_CHECK_ANIMATE_LIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,18,54,10
    CONTROL         "Gaussian Filter",IDC_CHECK_GAUSSIAN_FILTER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,18,54,10
    CONTROL         "Depth Buffer Shadow",IDC_CHECK_DEPTH_BUFFER_SHADOW,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,132,18,78,10
    CONTROL         "SSAO",IDC_CHECK_SSAO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,66,30,30,10
    CONTROL         "Bloom",IDC_CHECK_BLOOM,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,6,30,30,10
    CONTROL         "StarBurst",IDC_CHECK_STARBURST,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,132,30,42,10
    LTEXT           "Gaussian Size",IDC_STATIC_GAUSSIAN_SAMPLE_LABEL,6,84,48,8
    EDITTEXT        IDC_EDIT_GAUSSIAN_SAMPLE_SIZE,169,84,23,12,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_GAUSSIAN_SAMPLE_SIZE,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,90,84,78,12
    LTEXT           "Fog Density",IDC_STATIC_FOG_INTENSITY_LABEL,6,96,44,8
    EDITTEXT        IDC_EDIT_FOG_INTENSITY,169,96,24,12,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_FOG_INTENSITY,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,90,96,78,12
    LTEXT           "Shadow Intensity",IDC_STATIC_SHADOW_INTENSITY_LABEL,6,108,54,8
    EDITTEXT        IDC_EDIT_SHADOW_INTENSITY,168,108,24,12,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_SHADOW_INTENSITY,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,90,108,78,12
    LTEXT           "SSAO Brightness",IDC_STATIC_SSAO_BRIGHTNESS_LABEL,6,120,58,8
    EDITTEXT        IDC_EDIT_SSAO_BRIGHTNESS,168,120,24,12,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_SSAO_BRIGHTNESS,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,90,120,78,12
    LTEXT           "Bloom Threshold",IDC_STATIC_BLOOM_THRESHOLD_LABEL,6,132,58,8
    EDITTEXT        IDC_EDIT_BLOOM_THRESHOLD,168,132,24,12,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_BLOOM_THRESHOLD,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,90,132,78,12
    LTEXT           "StarBurst Threshold",IDC_STATIC_STARBURST_THRESHOLD_LABEL,6,144,62,8
    EDITTEXT        IDC_EDIT_STARBURST_THRESHOLD,168,144,24,12,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_STARBURST_THRESHOLD,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,90,144,78,12
    LTEXT           "Model Load Scale",IDC_STATIC_MODEL_LOAD_SCALE_LABEL,6,156,60,8
    EDITTEXT        IDC_EDIT_MODEL_LOAD_SCALE,168,156,24,12,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_MODEL_LOAD_SCALE,"msctls_trackbar32",TBS_AUTOTICKS | WS_TABSTOP,90,156,78,12
    LTEXT           "Mix Mesh (.x)",IDC_STATIC_MIX_MESH_LABEL,6,234,48,8
    EDITTEXT        IDC_EDIT_MIX_MESH_PATH,90,234,72,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_MIX_MESH,168,234,24,12
    LTEXT           "Mesh (.x)",IDC_STATIC_MESH_LABEL,6,246,44,8
    EDITTEXT        IDC_EDIT_MESH_PATH,90,246,72,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_MESH,168,246,24,12
    LTEXT           "Anim Mesh (.x)",IDC_STATIC_ANIM_MESH_LABEL,6,258,56,8
    EDITTEXT        IDC_EDIT_ANIM_MESH_PATH,90,258,72,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_ANIM_MESH,168,258,24,12
    LTEXT           "Skin Anim Mesh (.x)",IDC_STATIC_SKIN_ANIM_MESH_LABEL,6,270,74,8
    EDITTEXT        IDC_EDIT_SKIN_ANIM_MESH_PATH,90,270,72,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_SKIN_ANIM_MESH,168,270,24,12
    LTEXT           "Loaded Models",IDC_STATIC_LOADED_MODELS_LABEL,6,288,60,8
    CONTROL         "",IDC_LIST_LOADED_MODELS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,6,300,284,340
    DEFPUSHBUTTON   "OK",IDOK,174,644,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,240,644,50,14
END

#endif

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_SETTINGS_DIALOG, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 293
        TOPMARGIN, 7
        BOTTOMMARGIN, 657
    END
END
#endif
