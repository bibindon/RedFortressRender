#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_JPN)
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 240, 560
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "MS UI Gothic", 400, 0, 0x80
BEGIN
    LTEXT           "Saturation",IDC_STATIC_SATURATE_LABEL,12,14,44,8
    EDITTEXT        IDC_EDIT_SATURATE_LEVEL,62,12,48,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "-",IDC_BUTTON_SATURATE_DOWN,120,11,24,14
    PUSHBUTTON      "+",IDC_BUTTON_SATURATE_UP,148,11,24,14
    PUSHBUTTON      "Reset",IDC_BUTTON_SATURATE_RESET,176,11,40,14
    CONTROL         "",IDC_SLIDER_SATURATE_LEVEL,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,12,32,204,18
    CONTROL         "Animate Light",IDC_CHECK_ANIMATE_LIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,58,72,10
    CONTROL         "Gaussian Filter",IDC_CHECK_GAUSSIAN_FILTER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,96,58,80,10
    CONTROL         "Depth Buffer Shadow",IDC_CHECK_DEPTH_BUFFER_SHADOW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,70,92,10
    CONTROL         "SSAO",IDC_CHECK_SSAO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,120,70,48,10
    LTEXT           "Gaussian Size",IDC_STATIC_GAUSSIAN_SAMPLE_LABEL,12,84,54,8
    EDITTEXT        IDC_EDIT_GAUSSIAN_SAMPLE_SIZE,72,82,38,14,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_GAUSSIAN_SAMPLE_SIZE,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,12,102,204,18
    LTEXT           "Fog Density",IDC_STATIC_FOG_INTENSITY_LABEL,12,126,44,8
    EDITTEXT        IDC_EDIT_FOG_INTENSITY,72,124,38,14,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SLIDER_FOG_INTENSITY,"msctls_trackbar32",TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP,12,144,204,18
    LTEXT           "Mix Mesh (.x / .blend.x)",IDC_STATIC_MIX_MESH_LABEL,12,176,90,8
    EDITTEXT        IDC_EDIT_MIX_MESH_PATH,12,188,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_MIX_MESH,176,187,40,14
    LTEXT           "Mesh (.x)",IDC_STATIC_MESH_LABEL,12,222,44,8
    EDITTEXT        IDC_EDIT_MESH_PATH,12,234,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_MESH,176,233,40,14
    LTEXT           "Anim Mesh (.x)",IDC_STATIC_ANIM_MESH_LABEL,12,268,56,8
    EDITTEXT        IDC_EDIT_ANIM_MESH_PATH,12,280,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_ANIM_MESH,176,279,40,14
    LTEXT           "Skin Anim Mesh (.x)",IDC_STATIC_SKIN_ANIM_MESH_LABEL,12,314,74,8
    EDITTEXT        IDC_EDIT_SKIN_ANIM_MESH_PATH,12,326,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_SKIN_ANIM_MESH,176,325,40,14
    DEFPUSHBUTTON   "OK",IDOK,129,539,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,183,539,50,14
END

#endif

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_SETTINGS_DIALOG, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 233
        TOPMARGIN, 7
        BOTTOMMARGIN, 553
    END
END
#endif
