#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_JPN)
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 240, 560
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "MS UI Gothic", 400, 0, 0x80
BEGIN
    LTEXT           "Saturation",IDC_STATIC_SATURATE_LABEL,12,14,44,8
    EDITTEXT        IDC_EDIT_SATURATE_LEVEL,62,12,48,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "-",IDC_BUTTON_SATURATE_DOWN,120,11,24,14
    PUSHBUTTON      "+",IDC_BUTTON_SATURATE_UP,148,11,24,14
    PUSHBUTTON      "Reset",IDC_BUTTON_SATURATE_RESET,176,11,40,14
    CONTROL         "Animate Light",IDC_CHECK_ANIMATE_LIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,40,72,10
    CONTROL         "Gaussian Filter",IDC_CHECK_GAUSSIAN_FILTER,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,96,40,80,10
    LTEXT           "Mix Mesh (.x / .blend.x)",IDC_STATIC_MIX_MESH_LABEL,12,74,90,8
    EDITTEXT        IDC_EDIT_MIX_MESH_PATH,12,86,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_MIX_MESH,176,85,40,14
    LTEXT           "Mesh (.x)",IDC_STATIC_MESH_LABEL,12,120,44,8
    EDITTEXT        IDC_EDIT_MESH_PATH,12,132,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_MESH,176,131,40,14
    LTEXT           "Anim Mesh (.x)",IDC_STATIC_ANIM_MESH_LABEL,12,166,56,8
    EDITTEXT        IDC_EDIT_ANIM_MESH_PATH,12,178,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_ANIM_MESH,176,177,40,14
    LTEXT           "Skin Anim Mesh (.x)",IDC_STATIC_SKIN_ANIM_MESH_LABEL,12,212,74,8
    EDITTEXT        IDC_EDIT_SKIN_ANIM_MESH_PATH,12,224,160,14,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "Open...",IDC_BUTTON_OPEN_SKIN_ANIM_MESH,176,223,40,14
    DEFPUSHBUTTON   "OK",IDOK,129,539,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,183,539,50,14
END

#endif

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_SETTINGS_DIALOG, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 233
        TOPMARGIN, 7
        BOTTOMMARGIN, 553
    END
END
#endif
