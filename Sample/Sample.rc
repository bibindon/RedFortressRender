#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_JPN)
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 180, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "MS UI Gothic", 400, 0, 0x80
BEGIN
    CONTROL         "Remote Desktop",IDC_CHECK_REMOTE_DESKTOP,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,12,78,10
    CONTROL         "Move x100",IDC_CHECK_MOVE_SPEED_BOOST_100X,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,30,54,10
    CONTROL         "Animate Light",IDC_CHECK_ANIMATE_LIGHT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,48,66,10
    PUSHBUTTON      "Load Start",IDC_BUTTON_LOAD_START,12,66,72,14
END
#endif

#ifdef APSTUDIO_INVOKED
GUIDELINES DESIGNINFO
BEGIN
    IDD_SETTINGS_DIALOG, DIALOG
    BEGIN
        LEFTMARGIN, 7
        RIGHTMARGIN, 173
        TOPMARGIN, 7
        BOTTOMMARGIN, 63
    END
END
#endif
